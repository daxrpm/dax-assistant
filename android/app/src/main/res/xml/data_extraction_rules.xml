<?xml version="1.0" encoding="utf-8"?>
<!-- The device secret and any cached conversation must never leave the device
     through backup or transfer. Everything is excluded rather than
     selectively included, so a new file cannot be captured by accident. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
