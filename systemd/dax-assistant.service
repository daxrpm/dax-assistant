[Unit]
Description=Dax Personal AI Assistant (authoritative backend)
Documentation=https://github.com/daxrpm/dax-assistant
Wants=network-online.target
After=network-online.target graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/dax-assistant/current
ExecStart=%h/.local/share/dax-assistant/current/.venv/bin/dax
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=mixed
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment="DAX_STORAGE__DATABASE_PATH=%h/.local/state/dax-assistant/dax.db"
Environment="DAX_STORAGE__MODELS_PATH=%h/.local/share/dax-assistant/models"
Environment="DAX_MEMORY_PATH=%h/.local/state/dax-assistant/memory"
Environment="HF_HOME=%h/.cache/dax-assistant/huggingface"
# MCP stdio servers are commonly launched via user-local runners (uvx, npx).
# The default systemd --user PATH omits ~/.local/bin, so surface it here or the
# backend fails to spawn them with "No such file or directory: 'uvx'".
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"

# Safe for a desktop assistant. ProtectHome/PrivateDevices are intentionally not
# enabled because Dax provides user-approved file, application, and audio tools.
#
# CapabilityBoundingSet=, AmbientCapabilities=, RestrictSUIDSGID=, ProtectClock=,
# ProtectKernelModules=, and ProtectKernelLogs= are deliberately omitted: each one
# has systemd unconditionally call capset()/prctl(PR_CAPBSET_DROP) to enforce it
# (even just to narrow the set), which requires CAP_SETPCAP — a capability an
# ordinary --user login session never has. On a real user account (not root) they
# don't harden anything; they just make the service fail at exec with
# 218/CAPABILITIES every time.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
