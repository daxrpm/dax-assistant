[Unit]
Description=Dax Laptop Capability Node
Documentation=https://github.com/daxrpm/dax-assistant
Wants=network-online.target
After=network-online.target graphical-session.target
ConditionPathExists=%h/.local/state/dax-assistant/edge.json

[Service]
Type=simple
WorkingDirectory=%h/.local/share/dax-assistant/node-current
ExecStart=%h/.local/share/dax-assistant/node-current/.venv/bin/dax edge run --state-file %h/.local/state/dax-assistant/edge.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=mixed
UMask=0077
Environment=PYTHONUNBUFFERED=1

# This is an outbound client only. Home and desktop-session access are required
# for the explicitly approved dax-system file and desktop tools.
#
# CapabilityBoundingSet=, AmbientCapabilities=, RestrictSUIDSGID=, ProtectClock=,
# ProtectKernelModules=, and ProtectKernelLogs= are deliberately omitted: each one
# has systemd unconditionally call capset()/prctl(PR_CAPBSET_DROP) to enforce it
# (even just to narrow the set), which requires CAP_SETPCAP — a capability an
# ordinary --user login session never has. On a real user account (not root) they
# don't harden anything; they just make the service fail at exec with
# 218/CAPABILITIES every time.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
