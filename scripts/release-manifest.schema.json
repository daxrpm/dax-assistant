{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daxrpm/dax-assistant/releases/download/schema/release-manifest-v1.json",
  "title": "Dax release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "commit", "api_compatibility", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "api_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "desktop", "android", "capability_node"],
      "properties": {
        "backend": { "type": "string", "minLength": 1 },
        "desktop": { "type": "string", "minLength": 1 },
        "android": { "type": "string", "minLength": 1 },
        "capability_node": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name", "url", "arch", "sha256", "size"],
        "properties": {
          "role": {
            "enum": [
              "backend-wheel", "backend-sdist", "backend-dependency-lock", "desktop-rpm", "desktop-deb",
              "android-apk", "linux-installer", "backend-service", "node-service"
            ]
          },
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "arch": { "enum": ["any", "x86_64", "aarch64", "universal"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
